{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dagster",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "mkdir -p .dagster_home && DAGSTER_HOME=$PWD/.dagster_home .venv/bin/dagster dev -p ${PORT:-3000}"],
      "port": 3000
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", ".venv/bin/streamlit run app/dashboard.py --server.headless true --server.port ${PORT:-8501}"],
      "port": 8501
    }
  ]
}
